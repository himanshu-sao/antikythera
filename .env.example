# Antikythera development environment configuration
# ------------------------------------------------
# Server port for the backend API (D8: 18006; the backend binds 127.0.0.1 only)
PORT=18006

# Base URL of the backend API that the UI calls (the backend listens on PORT above).
# Do NOT point this at the frontend (15173): the UI would send API calls to itself.
# The frontend dev server itself runs on 15173 (D8).
VITE_API_URL=http://localhost:18006

# D1: bearer token for every /api/* route; unset = generated into ~/.antikythera/api_token (0600)
# ANTIKYTHERA_API_TOKEN=
# D1/D8: comma-separated UI origins allowed by CORS; default http://localhost:15173
# ANTIKYTHERA_CORS_ORIGINS=http://localhost:15173
# D1: Swagger UI and ReDoc are off by default; set to 1 to serve them at /docs
# ANTIKYTHERA_ENABLE_DOCS=1

# Jira integration credentials – used when connecting to a Jira Cloud instance
# Base URL of your Jira instance (e.g., https://yourdomain.atlassian.net)
JIRA_BASE_URL=https://your-jira-instance.atlassian.net
# Personal Access Token for Jira API authentication. Create one in Jira Settings > API Tokens.
JIRA_PAT=your_jira_pat_here

# Optional GitHub token if you plan to use GitHub adapters (not required for current features)
# GITHUB_TOKEN=your_github_token_here
