# Antikythera Frontend (UI)
# Multi-stage build: Node builder + lightweight runtime

# ------------------------------------------------------------------------------
# Stage 1: Builder - Install dependencies and build
# ------------------------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app/ui

# Copy package files
COPY ui/package.json ui/package-lock.json* ./

# Install dependencies
RUN npm ci --legacy-peer-deps 2>/dev/null || npm install --legacy-peer-deps

# Copy source code
COPY ui/ ./

# Build the frontend
RUN npm run build

# ------------------------------------------------------------------------------
# Stage 2: prod - nginx serving the built UI and proxying /api/ to the backend (O1)
# Used by docker-compose.prod.yml via `target: prod`.
# Declared BEFORE `runtime` on purpose: a plain `docker build` (build-docker.sh,
# test-docker.sh, docker-compose.yml) builds the LAST stage, which must stay the Vite
# dev-server image that the published himanshusao/antikythera-ui image has always been.
# ------------------------------------------------------------------------------
FROM nginx:alpine AS prod

# The bundle is built without VITE_API_URL, so ui/src/config.ts uses relative /api URLs
# and nginx.conf proxies them to http://backend:8006 on the compose network.
COPY --from=builder /app/ui/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD wget -q --spider http://localhost/ || exit 1

# ------------------------------------------------------------------------------
# Stage 3: Runtime (final stage, so the default target) - runs the Vite DEV server, used
# by docker-compose.yml and docker-compose.user.yml. For production see the `prod` stage.
# ------------------------------------------------------------------------------
FROM node:20-alpine AS runtime

WORKDIR /app/ui

# Copy package files for runtime dependencies
COPY ui/package.json ./

# Install only production dependencies if needed, but we'll use vite for dev
RUN npm install --legacy-peer-deps

# Copy built assets from builder
COPY --from=builder /app/ui/dist ./dist
COPY --from=builder /app/ui/node_modules ./node_modules
COPY --from=builder /app/ui/package.json ./

# Copy vite config (needed for dev server proxy)
COPY ui/vite.config.ts ./vite.config.ts
COPY ui/index.html ./index.html

# Copy entrypoint script
COPY docker/ui-entrypoint.sh /usr/local/bin/ui-entrypoint.sh
RUN chmod +x /usr/local/bin/ui-entrypoint.sh

# Expose Vite dev server port
EXPOSE 5173

# Entrypoint handles config validation and starts Vite
ENTRYPOINT ["/usr/local/bin/ui-entrypoint.sh"]

# Default: run Vite dev server
CMD ["dev", "--host", "0.0.0.0", "--port", "5173"]
